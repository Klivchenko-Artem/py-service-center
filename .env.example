# Пример окружения для запуска без docker compose
SECRET_KEY=поменяй-меня-на-длинный-секрет
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://service:service@localhost:5432/service
# Включается, когда сервис работает по https
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
